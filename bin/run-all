#!/usr/bin/env python
"""Run the pipeline over every registered feed and report a table.

Every city is a fresh set of GTFS quirks, so failures are expected and are the
point: this prints what broke and where, rather than stopping at the first one.
"""
from __future__ import annotations

import sys
import time
import traceback

from schematic import feeds, pipeline


def main(keys: list[str]) -> int:
    keys = keys or list(feeds.FEEDS)
    rows, failures = [], []
    for key in keys:
        t0 = time.time()
        try:
            r = pipeline.run(key)
            a = r.animation
            rows.append({
                "key": key,
                "stations": len(r.graph.stations),
                "lines": len(r.graph.labels),
                "trips": len(r.trips),
                "unrouted": len(a.unrouted),
                "stops": f"{r.match.coverage:.0%}",
                "labels_lost": len(r.render.dropped_labels),
                "secs": f"{time.time() - t0:.0f}",
            })
            print(f"OK    {key:22} {len(r.graph.stations):4} stations, "
                  f"{len(r.graph.labels):2} lines, {len(r.trips):5} trips "
                  f"({time.time() - t0:.0f}s)", flush=True)
        except Exception as exc:  # noqa: BLE001 - a survey, not a library call
            where = traceback.extract_tb(exc.__traceback__)[-1]
            failures.append((key, f"{type(exc).__name__}: {exc}"[:150],
                             f"{where.filename.split('/')[-1]}:{where.lineno}"))
            print(f"FAIL  {key:22} {type(exc).__name__}: {str(exc)[:90]}", flush=True)

    if rows:
        cols = list(rows[0])
        width = {c: max(len(c), *(len(str(r[c])) for r in rows)) for c in cols}
        print("\n" + "  ".join(c.ljust(width[c]) for c in cols))
        print("  ".join("-" * width[c] for c in cols))
        for r in rows:
            print("  ".join(str(r[c]).ljust(width[c]) for c in cols))

    if failures:
        print(f"\n{len(failures)} failed:")
        for key, msg, where in failures:
            print(f"  {key:22} {msg}   ({where})")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
