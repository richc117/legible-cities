#!/usr/bin/env node
// Exercise the built site the way a visitor does: follow real links and assert
// where they land. Checking the markup is not enough -- a back-link whose href
// is present and wrong looks fine in the HTML and 404s in the browser.
//
//   bin/preview-site &   then   node bin/check-site
const path = require("path");
let chromium;
try {
  ({ chromium } = require(path.join(__dirname, "..", "site", "node_modules", "playwright")));
} catch (e) {
  console.error("playwright missing. cd site && npm install --no-save playwright && npx playwright install chromium");
  process.exit(1);
}

const BASE = process.env.BASE_URL || "http://localhost:4321";
const strip = u => u.replace(BASE, "") || "/";

(async () => {
  const browser = await chromium.launch();
  const ctx = await browser.newContext({ viewport: { width: 1280, height: 900 } });
  const page = await ctx.newPage();
  const failures = [];
  const httpErrors = [];
  page.on("response", r => { if (r.status() >= 400) httpErrors.push(r.status() + " " + strip(r.url())); });
  page.on("pageerror", e => failures.push("JS error: " + e));

  const expect = (got, want, what) => {
    const ok = got === want;
    console.log(`${ok ? "ok  " : "FAIL"}  ${what}: ${got}${ok ? "" : "  (expected " + want + ")"}`);
    if (!ok) failures.push(what);
  };

  // Primary nav reaches every page.
  for (const [label, want] of [["Essay", "/"], ["Atlas", "/atlas/"], ["Colophon", "/colophon/"]]) {
    await page.goto(BASE + "/", { waitUntil: "networkidle" });
    await page.locator(`.site-nav a:text-is("${label}")`).click();
    await page.waitForLoadState("networkidle");
    expect(strip(page.url()), want, `nav "${label}"`);
  }

  // Atlas entry opens a running map, and its back-link returns to the atlas.
  await page.goto(BASE + "/atlas/", { waitUntil: "networkidle" });
  const count = await page.locator(".atlas > li").count();
  console.log(`ok    atlas lists ${count} networks`);
  await page.locator("a.thumb").first().click();
  await page.waitForLoadState("networkidle");
  const city = strip(page.url());
  console.log(`ok    atlas -> ${city}`);
  await page.locator("a.back").click();
  await page.waitForLoadState("networkidle");
  expect(strip(page.url()), "/atlas/", "running map back-link");

  // The animation actually runs: trains appear and the clock advances.
  await page.goto(BASE + city, { waitUntil: "networkidle" });
  await page.waitForTimeout(1500);
  const t1 = await page.locator("#clock").innerText();
  const trains = await page.locator("#trains circle").count();
  await page.waitForTimeout(1500);
  const t2 = await page.locator("#clock").innerText();
  console.log(`${trains > 0 ? "ok  " : "FAIL"}  ${trains} trains drawn`);
  console.log(`${t1 !== t2 ? "ok  " : "FAIL"}  clock advances: ${t1} -> ${t2}`);
  if (!trains) failures.push("no trains drawn");
  if (t1 === t2) failures.push("clock did not advance");

  // Controls do what they say.
  const before = await page.locator("#labels\\-toggle").getAttribute("aria-pressed");
  await page.locator("#labels\\-toggle").click();
  const after = await page.locator("#labels\\-toggle").getAttribute("aria-pressed");
  const hidden = await page.locator("#labels").evaluate(el => el.style.display === "none");
  console.log(`${before !== after && hidden ? "ok  " : "FAIL"}  labels toggle hides the names`);
  if (!(before !== after && hidden)) failures.push("labels toggle");

  // The linear view: unfolds, sorts, folds back to exactly the map it left.
  await page.goto(BASE + city, { waitUntil: "networkidle" });
  await page.waitForTimeout(800);
  const mapD = await page.locator("#lines path").first().getAttribute("d");
  const mapTrains = await page.locator("#trains circle").count();

  await page.locator("#view-linear").click();
  await page.waitForTimeout(2600);
  const rows = await page.locator("#linear-names text").count();
  const linDots = await page.locator("#linear-stations circle").count();
  const linLabels = await page.locator("#linear-labels text").count();
  const linTrains = await page.locator("#trains circle").count();
  console.log(`${rows > 0 ? "ok  " : "FAIL"}  linear view: ${rows} rows, ${linDots} stations, ${linTrains} trains`);
  if (!rows) failures.push("no rows in linear view");
  expect(linLabels, linDots, "every station in a row is named");

  // A train must sit on its line's row, not somewhere between views.
  const onRow = await page.evaluate(() => {
    const rowY = [...document.querySelectorAll("#linear-names text")].map(t => +t.getAttribute("y"));
    const svg = document.querySelector("#stage svg");
    const box = svg.getBoundingClientRect();
    const vb = svg.getAttribute("viewBox").split(/\s+/).map(Number);
    const scale = box.height / vb[3];
    return [...document.querySelectorAll("#trains circle")].every(c => {
      const y = +c.getAttribute("cy");
      return rowY.some(r => Math.abs(r - y) < 40 / scale + 40);
    });
  });
  console.log(`${onRow ? "ok  " : "FAIL"}  every train sits on a row`);
  if (!onRow) failures.push("trains off-row in linear view");

  const readOrder = () => [...document.querySelectorAll("#linear-names text")]
    .map(t => ({ l: t.textContent, y: +t.getAttribute("y") }))
    .sort((a, b) => a.y - b.y).map(o => o.l);
  const byLine = await page.evaluate(readOrder);
  await page.locator("#sort-size").click();
  await page.waitForTimeout(2400);
  const bySize = await page.evaluate(readOrder);
  const reordered = byLine.join() !== bySize.join();
  console.log(`${reordered ? "ok  " : "FAIL"}  sorting reorders the rows`);
  if (!reordered) failures.push("sort did nothing");

  // The time chart: every route drawn, an axis, a playhead that tracks the clock.
  await page.locator("#view-string").click();
  await page.waitForTimeout(2800);
  const chart = await page.evaluate(() => {
    const sl = document.querySelector("#stringline");
    const paths = [...sl.querySelectorAll("g > path")];
    return {
      opacity: +sl.getAttribute("opacity"),
      routes: paths.filter(p => (p.getAttribute("d") || "").length > 2).length,
      ticks: sl.querySelectorAll("#stringline-axis text").length,
      head: +document.querySelector("#playhead").getAttribute("x1"),
      trains: document.querySelectorAll("#trains circle").length,
    };
  });
  const chartOk = chart.opacity > 0.9 && chart.routes > 0 && chart.ticks > 1 && chart.trains > 0;
  console.log(`${chartOk ? "ok  " : "FAIL"}  time chart: ${chart.routes} routes, ` +
              `${chart.ticks} hour marks, ${chart.trains} trains on the playhead`);
  if (!chartOk) failures.push("time chart did not draw");

  // The playhead must follow the clock, not sit still.
  const h1 = chart.head;
  await page.waitForTimeout(1600);
  const h2 = await page.evaluate(() => +document.querySelector("#playhead").getAttribute("x1"));
  console.log(`${h2 !== h1 ? "ok  " : "FAIL"}  playhead advances with the clock`);
  if (h2 === h1) failures.push("playhead frozen");

  await page.locator("#view-map").click();
  await page.waitForTimeout(2800);
  const backD = await page.locator("#lines path").first().getAttribute("d");
  expect(backD, mapD, "map geometry restored exactly");
  const backTrains = await page.locator("#trains circle").count();
  console.log(`${backTrains > 0 ? "ok  " : "FAIL"}  trains still running after the round trip (${mapTrains} -> ${backTrains})`);
  if (!backTrains) failures.push("no trains after round trip");

  if (httpErrors.length) {
    console.log("FAIL  HTTP errors:", [...new Set(httpErrors)].slice(0, 6).join(", "));
    failures.push("http");
  } else {
    console.log("ok    no 4xx/5xx during navigation");
  }

  await browser.close();
  console.log(failures.length ? `\n${failures.length} failure(s)` : "\nall checks passed");
  process.exit(failures.length ? 1 : 0);
})();
