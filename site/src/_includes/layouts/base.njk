<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="{{ site.themeColor }}">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="{{ site.shortTitle }}">
    <link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="any">
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon/favicon.svg' | url }}">
    <link rel="icon" type="image/png" sizes="96x96" href="{{ '/assets/favicon/favicon-96x96.png' | url }}">
    <link rel="apple-touch-icon" href="{{ '/assets/favicon/apple-touch-icon.png' | url }}">
    <link rel="manifest" href="{{ '/assets/favicon/site.webmanifest' | url }}">

    {# What Slack, Teams, Messenger, LinkedIn and Bluesky read when the link is
       pasted. All of them fetch these from their own servers, so og:image and
       og:url have to be absolute -- a root-relative path silently unfurls as
       no picture at all, which is what this site did before. The card is a
       raster on purpose: none of them will render an SVG. #}
    <link rel="canonical" href="{{ page.url | absolute }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ page.url | absolute }}">
    <meta property="og:image" content="{{ site.card.image | absolute }}">
    <meta property="og:image:width" content="{{ site.card.width }}">
    <meta property="og:image:height" content="{{ site.card.height }}">
    <meta property="og:image:alt" content="{{ site.card.alt }}">
    {# Not only for X: LinkedIn and several chat clients fall back to these. #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="{{ site.card.image | absolute }}">

    <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
    <script src="{{ '/assets/theme.js' | url }}"></script>
    <script defer src="{{ '/assets/embed.js' | url }}"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        {# The brand is the home link, so it takes the same current-page mark
           the other two carry -- without it the landing page is the one page
           whose nav says nothing about where you are. #}
        <a class="brand" href="{{ '/' | url }}" {% if page.url == "/" %}aria-current="page"{% endif %}>{{ site.title }}</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="{{ '/atlas/' | url }}" {% if page.url == "/atlas/" %}aria-current="page"{% endif %}>Atlas</a>
          <a href="{{ '/framework/' | url }}" {% if page.url == "/framework/" %}aria-current="page"{% endif %}>Framework</a>
          <label class="theme-switch" aria-label="Toggle color theme">
            <input id="theme-toggle" type="checkbox" role="switch" aria-label="Theme toggle">
            <span class="slider" aria-hidden="true"></span>
          </label>
        </nav>
      </div>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site-footer wrap">
      <span class="byline">
        A project by
        <a href="{{ site.links.portfolio }}" target="_blank" rel="noopener noreferrer">{{ site.author }}</a>
      </span>
      <a href="{{ '/framework/' | url }}">Credits</a>
      {% if site.links.repo %}
        <a href="{{ site.links.repo }}" target="_blank" rel="noopener noreferrer">Source</a>
      {% endif %}
      <a href="{{ site.links.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="{{ site.links.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </footer>
  </body>
</html>
