<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="{{ site.themeColor }}">
    <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
    <script src="{{ '/assets/theme.js' | url }}"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="{{ '/' | url }}">{{ site.title }}</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="{{ '/' | url }}" {% if page.url == "/" %}aria-current="page"{% endif %}>Essay</a>
          <a href="{{ '/atlas/' | url }}" {% if page.url == "/atlas/" %}aria-current="page"{% endif %}>Atlas</a>
          <a href="{{ '/colophon/' | url }}" {% if page.url == "/colophon/" %}aria-current="page"{% endif %}>Colophon</a>
          <label class="theme-switch" aria-label="Toggle color theme">
            <input id="theme-toggle" type="checkbox" role="switch" aria-label="Theme toggle">
            <span class="slider" aria-hidden="true"></span>
          </label>
        </nav>
      </div>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site-footer wrap">
      <span>{{ site.author }}</span>
      {% if site.links.repo %}
        <a href="{{ site.links.repo }}" target="_blank" rel="noopener noreferrer">Source</a>
      {% endif %}
      <a href="{{ '/colophon/' | url }}">Credits</a>
      <a href="{{ site.links.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="{{ site.links.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </footer>
  </body>
</html>
