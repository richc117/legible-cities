{# One definition of a network's affordances, imported by both the essay and
   the atlas. The two pages showed the same four links written out twice, and a
   presentation URL is fiddly enough -- four query parameters, and the
   parenthesised `('/maps/' + x) | url` that Nunjucks needs because it binds a
   filter tighter than `+` -- that a second copy would eventually drift. #}

{% macro links(n) %}
<p class="meta">
  <a href="{{ ('/maps/' + n.animation) | url }}">Running map</a> &middot;
  {# `controls=1` is the switcher and nothing else. Deliberately here and not on
     the iframe below: the essay's figures draw their own switcher outside the
     frame, and an export must never set it -- a control visible under present=1
     is captured into the video, and moves on the beat while it is. #}
  <a href="{{ ('/maps/' + n.animation + '?present=1&controls=1&clock=1&title=1&city=' + (n.city | urlencode) + '&network=' + (n.network | urlencode)) | url }}"
     title="The visualization on its own, with only the view switcher around it">Presentation</a> &middot;
  <a href="{{ ('/maps/' + n.svg) | url }}">SVG</a> &middot;
  <a href="{{ n.feed_url }}" target="_blank" rel="noopener noreferrer">Source feed</a>
</p>
{% endmacro %}

{# A live map in the essay: the generated animation page in presentation mode,
   inside an iframe. Presentation mode already hides that page's own header and
   toolbar and fits the network to whatever window it finds -- which, in an
   iframe, is the iframe -- so this is the same renderer the atlas and the
   exporter drive, not a second one.

   `labels` defaults off: the SVG is drawn 1600px wide, and at the essay's
   600px measure a station name lands around 4px. The running map, one link
   away, is where names are read.

   The caption is passed as a block: `{% call embed(n) %}...{% endcall %}`. #}
{% macro embed(n, eager=false, labels=false, view="map", controls=true, sequence="", lines="", cycle=false) %}
<figure class="figure figure--embed"{% if cycle %} data-cycle="1"{% endif %}>
  <div class="embed">
    <iframe class="embed-frame"
            title="{{ n.name }}, running its timetable"
            loading="{{ 'eager' if eager else 'lazy' }}"
            src="{{ ('/maps/' + n.animation + '?present=1&view=' + view + '&labels=' + ('1' if labels else '0') + ('&sequence=' + sequence if sequence else '') + ('&lines=' + lines if lines else '')) | url }}"></iframe>
  </div>
  <div class="embed-bar">
    {# A figure making an argument of its own gets no switcher: the sequence it
       runs is the point, and four buttons invite the reader to interrupt it. #}
    {% if controls %}
      {# Mirrors the switcher in the animation page's own toolbar, so the two
         read as the same control. Disabled until the frame reports `load` and
         window.__present exists; embed.js enables them. #}
      <span class="segmented" role="group" aria-label="View">
        {# Icons on every device, so there is one rendering rather than two.
           The accessible name is the button's aria-label; the title is the
           tooltip a sighted pointer user gets. `map` is labelled "Schematic":
           the word changed, the key did not, because it is written into every
           atlas link and every storyboard. #}
        {% for v, label, tip in [
             ["geographic", "Geographic", "Where the track actually runs"],
             ["map", "Schematic", "Straightened onto a 45° grid"],
             ["linear", "Linear", "One row per line"],
             ["time", "Time", "The service day as a Marey chart"]] %}
          <button type="button" data-view="{{ v }}" aria-label="{{ label }}" title="{{ tip }}"
                  aria-pressed="{{ 'true' if v == view else 'false' }}" disabled></button>
        {% endfor %}
      </span>
    {% endif %}
    {{ links(n) }}
  </div>
  <figcaption>{{ caller() }}</figcaption>
</figure>
{% endmacro %}
